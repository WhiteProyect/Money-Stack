# Money-Stack frontend — variables de entorno
# Copiar a .env.local (no versionar)

# URL base de la API (en dev: http://localhost:4000; en prod: https://api.tudominio.com)
NEXT_PUBLIC_API_URL=http://localhost:4000

# URL del sitio público (para OG/meta)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Solo para desarrollo: habilitar modo debug del cliente API
NEXT_PUBLIC_DEBUG_API=false
