NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/moneystack?schema=public"

# JWT: genera con  node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# bcrypt (12 recomendado)
BCRYPT_SALT_ROUNDS=12

# Sesión: intentos fallidos antes de bloquear la cuenta y minutos de bloqueo
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
# Cookie del refresh token. lax = frontend y API en el mismo sitio (tudominio.com y api.tudominio.com).
# none = frontend en otro dominio distinto (requiere HTTPS).
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# CORS: orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5173,https://tudominio.com

# Nº de proxies delante de la app (0 en local; 1 con Nginx/Cloudflare/PaaS)
TRUST_PROXY=0

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
BOOKING_RATE_LIMIT_MAX=5

# Solo para el primer SUPER_ADMIN (npm run db:seed). Borra la contraseña después.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=
